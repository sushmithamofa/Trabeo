# Trabeo - what never goes to GitHub.
# The repository is PRIVATE and holds everything needed to develop on another PC, clients'
# drawings included (the owner's decision, 2026-10-26). Left out: what the app makes again by
# itself, and this PC's sign-in files.

# --- made by the app on every run (analyses, caches) ---
runs/
__pycache__/
*.pyc
_c2r_project/
dxf_cache/

# --- sign-in: tied to this PC (its folder and approved users); on another PC they would lock
#     the app. Without them the app opens with no sign-in. The admin key never lives here. ---
access/
access_config.json

# --- editors and the operating system ---
.vscode/
.idea/
Thumbs.db
desktop.ini
